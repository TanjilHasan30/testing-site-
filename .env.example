# GEMINI_API_KEY: Optional server-side Gemini AI key for future AI-assisted discovery.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VIDEO_PROVIDER_API_TOKEN: Optional Cloudflare Stream or dedicated video service API token.
# Leave empty to run in clearly labeled local/demo video preview mode.
VIDEO_PROVIDER_ACCOUNT_ID=""
VIDEO_PROVIDER_API_TOKEN=""

# BANGLADESH_PAYMENT_SANDBOX: Payment gateway credentials (bKash, Nagad, SSLCommerz).
# Never commit real secrets. Sandbox mode is active when credentials are unset.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
NAGAD_MERCHANT_ID=""
PAYMENT_WEBHOOK_SECRET=""

# COURIER_API_KEY: Optional third-party Bangladesh courier integration (Pathao, Steadfast, RedX).
COURIER_API_KEY=""
